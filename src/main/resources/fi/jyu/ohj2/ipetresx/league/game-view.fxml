<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fi.jyu.ohj2.ipetresx.league.controllers.GameViewController">
   <children>
      <TableView fx:id="gameTable" VBox.vgrow="ALWAYS" />
      <HBox nodeOrientation="LEFT_TO_RIGHT" VBox.vgrow="NEVER">
         <children>
            <HBox alignment="CENTER" HBox.hgrow="ALWAYS">
               <children>
                  <Button fx:id="addButton" mnemonicParsing="false" prefHeight="26.0" prefWidth="110.0" text="Add game">
                     <HBox.margin>
                        <Insets />
                     </HBox.margin>
                  </Button>
               </children>
               <HBox.margin>
                  <Insets top="10.0" />
               </HBox.margin>
            </HBox>
            <HBox alignment="CENTER" spacing="20.0" HBox.hgrow="ALWAYS">
               <children>
                  <Button fx:id="editButton" mnemonicParsing="false" prefHeight="26.0" prefWidth="70.0" text="Edit" />
                  <Button fx:id="deleteButton" mnemonicParsing="false" prefHeight="26.0" prefWidth="70.0" text="Delete" />
               </children>
               <HBox.margin>
                  <Insets top="10.0" />
               </HBox.margin>
            </HBox>
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" />
         </padding>
      </HBox>
   </children>
</VBox>
